{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "entity_id": {"type": ["null", "string"]},
    "campaign_id": {"type": ["null", "string"]},
    "date": {"type": ["null", "string"], "format": "date"},
    "conversions": {"type": ["null", "number"], "description": "Goal conversions from clicks plus views."},
    "click_through_conversions": {"type": ["null", "number"]},
    "view_through_conversions": {"type": ["null", "number"]},
    "order_created_attributed_sales": {"type": ["null", "string"]},
    "order_created_attributed_sales_currency": {"type": ["null", "string"]},
    "attributed_events": {
      "type": ["null", "array"],
      "description": "Per-event counts, including events that are not the campaign goal.",
      "items": {"type": "object", "additionalProperties": true}
    },
    "account_currency": {"type": ["null", "string"]},
    "timezone": {"type": ["null", "string"]},
    "attribution_window_days": {"type": ["null", "integer"]},
    "view_through_attribution_window_days": {"type": ["null", "integer"]},
    "attribution_time_basis": {"type": ["null", "string"]}
  }
}
