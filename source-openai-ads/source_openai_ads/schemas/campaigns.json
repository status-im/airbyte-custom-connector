{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": {"type": ["null", "string"]},
    "name": {"type": ["null", "string"]},
    "description": {"type": ["null", "string"]},
    "status": {"type": ["null", "string"], "description": "active, paused, or archived."},
    "bidding_type": {"type": ["null", "string"], "description": "impressions, clicks, or conversions."},
    "mode": {"type": ["null", "string"]},
    "budget": {
      "type": ["null", "object"],
      "additionalProperties": true,
      "description": "lifetime_spend_limit_micros is millionths of the currency unit."
    },
    "conversion_event_setting_ids": {"type": ["null", "array"], "items": {"type": "string"}},
    "targeting": {"type": ["null", "object"], "additionalProperties": true},
    "start_time": {"type": ["null", "integer"]},
    "end_time": {"type": ["null", "integer"]},
    "created_at": {"type": ["null", "integer"]},
    "updated_at": {"type": ["null", "integer"]}
  }
}
